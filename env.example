# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ichiban?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# BAC Credomatic Payment Gateway
BAC_API_KEY="your-bac-api-key"
BAC_API_SECRET="your-bac-api-secret"
BAC_MERCHANT_ID="your-bac-merchant-id"
BAC_WEBHOOK_SECRET="your-bac-webhook-secret"

# YouTube API
YOUTUBE_API_KEY="your-youtube-api-key"

# Resend Email Service
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@ichiban.com"

# App
APP_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
